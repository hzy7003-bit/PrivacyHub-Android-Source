    <style name="PorcelainLight" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/ph_light_primary</item>
        <item name="android:colorBackground">@color/ph_light_canvas</item>
        <item name="android:windowBackground">@color/ph_light_canvas</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="PorcelainDark" parent="android:style/Theme.Material.NoActionBar">
